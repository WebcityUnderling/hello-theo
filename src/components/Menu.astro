---
import favourites from "../data/favourites.json";
---

<!--
  TASK 5: Develop this shared menu.
  The shared data and links are provided. Add your styles in main.css.
  1. Design the menu's layout, spacing, colours, and link states.
  2. Hide the favourites list until someone hovers over .favourites-menu.
  3. Use the CSS :hover pseudo-class to reveal the dropdown.
  4. Keep it visible while the pointer moves from the label to a link.

  Start with the hover interaction, then explore keyboard and touch support.
  See Task 5 in README.md for hints and optional extensions.
-->
<nav class="site-menu" aria-label="Main navigation">
	<a href="/">Home</a>
	<div class="favourites-menu">
		<div>Themes</div>
		<ul>
			{Object.entries(favourites).map(([slug, favourite]) => (
				<li>
					<a href={`/favourites/${slug}/`}>{favourite.name}</a>
				</li>
			))}
		</ul>
	</div>
</nav>
