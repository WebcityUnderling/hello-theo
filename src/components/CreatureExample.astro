---
// Finished reference character. Build your own design in Creature.astro.
---

<div class="creature-base">
    <!-- Eyes -->
    <div class="eyes">
        <div class="eye">
            <span data-follow-mouse></span>
        </div>
        <div class="eye">
            <span data-follow-mouse></span>
        </div>
    </div>
    <!-- Features, add ears, nose, mouth and hair, and any other characteristics! -->
    <div class="creature-features">

        <div class="mouth"></div>
        <div class="nose"></div> 
        <div class="ear-inside left"></div>
        <div class="ear-inside right"></div>

        <div class="eyebrow left"></div>
        <div class="eyebrow right"></div>
    </div>
</div>

<script>
    import { attachEyeTracking } from "../utility/eyeMath.js";

    const pupils = document.querySelectorAll("[data-follow-mouse]");
    attachEyeTracking(pupils);
</script>

<style>
.creature-base {
	--creature-base-color: #4972ff;
	--creature-eye-size: 30%;
	--creature-pupil-size: 70%;
}

.creature-base {
	position: absolute;
	transform: translate(-50%, -50%);
	top: 50%;
	left: 50%;
	background-color: var(--creature-base-color);
	width: 100%;
	height: 100%;
}

.eyes {
	position: absolute;
	display: flex;
	justify-content: center;
	width: 100%;
	height: var(--creature-eye-size);
}

.eye {
	width: var(--creature-eye-size);
	height: 100%;
	background-color: white;
	border-radius: 999px;
	overflow: hidden;
	position: relative;
}

.eye span {
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	width: var(--creature-pupil-size);
	height: var(--creature-pupil-size);
	display: block;
	position: absolute;
	background-color: black;
	border-radius: 999px;
}

.creature-features {
	position: absolute;
	width: 100%;
	height: 100%;
	top: 0;
	left: 0;
}

/* Add updates to the base and eyes (if you like!) */

.creature-base {
	clip-path: polygon(51% 9%, 79% 12%, 96% 0, 100% 64%, 85% 95%, 50% 100%, 17% 93%, 1% 67%, 3% 0, 22% 12%);
}

.eyes {
	top: 30%;
	gap: 3%;
}

/* Your features here */

.nose {
	background-color: #ffabab;
	position: absolute;
	width: 18%;
	height: 12%;
	clip-path: polygon(50% 0%, 94% 10%, 100% 51%, 69% 44%, 69% 71%, 50% 100%, 33% 70%, 32% 43%, 0 55%, 8% 11%);

	top: 59%;
	left: 40%;
}

.ear-inside {
	background-color: #ffabab;
	position: absolute;
	width: 10%;
	height: 20%;
	clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
}

.ear-inside.right {
	top: 5%;
	right: 7%;
	transform: rotate(30deg);
}

.ear-inside.left {
	top: 5%;
	left: 5%;
	transform: rotate(-30deg);
}

.mouth {
	background-color: black;
	position: absolute;
	width: 25%;
	height: 25%;
	clip-path: polygon(52% 0, 65% 78%, 91% 13%, 100% 20%, 66% 100%, 50% 52%, 33% 100%, 0 21%, 8% 14%, 32% 78%);
	top: 63%;
	left: 37%;
}

.eyebrow {
	background-color: rgb(35, 19, 159);
	position: absolute;
	width: 32%;
	height: 8%;
}

.eyebrow.right {
	top: 28%;
	left: 49%;
	transform: rotate(-10deg);
}

.eyebrow.left {
	top: 28%;
	right: 49%;
	transform: rotate(10deg);
}
</style>
