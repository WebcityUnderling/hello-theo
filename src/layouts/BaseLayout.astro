---
import "../styles/main.css";
import Menu from "../components/Menu.astro";

// Pages can supply their own title and description, or use these defaults.
const { title = "My website", description = "A bit about me and what I'm into" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Task 1: personalise the browser tab title and description too. -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anta&family=Prompt:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Rubik+Dirt&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- TASK 5: Add a menu -->
		<Menu />
		<main>
			<slot />
		</main>
	</body>
</html>
